          </mxGeometry>
        </mxCell>
        <mxCell id="p3_es_push" value="localTxCount &amp;gt; 0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2563EB;strokeWidth=2;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="p3_1" source="p3_s_mode_check" target="p3_ps_1">
          <mxGeometry relative="1" as="geometry">
