        <mxCell id="p1_e1_17" value="Simpan ke File" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#8B5CF6;strokeWidth=2;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="p1_1" source="p1_cloud_sheets" target="p1_cloud_file">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p2" name="2. Alur Transaksi &amp; Saldo">
    <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="p2_0" />
        <mxCell id="p2_1" parent="p2_0" />
        <mxCell id="p2_title" value="&lt;b style=&quot;font-size:18px;&quot;&gt;WLLT.Z — ALUR TRANSAKSI &amp;amp; INTEGRITAS MUTASI SALDO&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#475569;&quot;&gt;Alur detil mutasi multi-tipe (Income, Expense, Transfer, Debt), alokasi budget bertingkat, dan mekanisme reversal saldo&lt;/span&gt;" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#F8FAFC;strokeColor=#CBD5E1;align=left;spacingLeft=25;fontColor=#0F172A;" vertex="1" parent="p2_1">
          <mxGeometry x="40" y="20" width="1620" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p2_lane_create" value="ALUR PENCATATAN TRANSAKSI BARU (CREATE TRANSACTION)" style="swimlane;html=1;startSize=40;fillColor=#F8FAFC;strokeColor=#93C5FD;swimlaneHeadColor=#DBEAFE;fontColor=#1E3A8A;fontStyle=1;rounded=1;arcSize=4;" vertex="1" parent="p2_1">
          <mxGeometry x="40" y="100" width="1020" height="1000" as="geometry" />
        </mxCell>
        <mxCell id="p2_tx_start" value="&lt;b&gt;Pengguna Mengisi Form Transaksi&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;Modal: AddTransactionModal.tsx (Nominal, Kategori, Dompet, Jenis)&lt;/span&gt;" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#3B82F6;fontColor=#0F172A;" vertex="1" parent="p2_1">
          <mxGeometry x="70" y="160" width="960" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p2_tx_hook" value="&lt;b&gt;Panggil Hook useCreateTransaction()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;Validasi input &amp;amp; generate UUID lokal: crypto.randomUUID()&lt;/span&gt;" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E40AF;" vertex="1" parent="p2_1">
          <mxGeometry x="70" y="235" width="960" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p2_tx_step1" value="&lt;b&gt;Step 1: Simpan Rekaman Transaksi ke IndexedDB&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;transactionRepo.create(dto) &amp;rarr; db.transactions.add({ sync_status: &amp;quot;local_only&amp;quot;, is_deleted: false })&lt;/span&gt;" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#ECFDF5;strokeColor=#10B981;fontColor=#065F46;" vertex="1" parent="p2_1">
          <mxGeometry x="70" y="310" width="960" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p2_t_inc" value="&lt;b&gt;Pemasukan (income)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#065F46;&quot;&gt;delta = +amount&lt;br&gt;walletRepo.updateBalance()&lt;/span&gt;" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#D1FAE5;strokeColor=#059669;fontColor=#065F46;" vertex="1" parent="p2_1">
          <mxGeometry x="70" y="390" width="220" height="65" as="geometry" />
        </mxCell>
        <mxCell id="p2_t_exp" value="&lt;b&gt;Pengeluaran (expense)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#991B1B;&quot;&gt;delta = -amount&lt;br&gt;walletRepo.updateBalance()&lt;/span&gt;" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#991B1B;" vertex="1" parent="p2_1">
          <mxGeometry x="315" y="390" width="225" height="65" as="geometry" />
        </mxCell>
        <mxCell id="p2_t_trans" value="&lt;b&gt;Transfer Antar Dompet&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#3730A3;&quot;&gt;asal = -amount&lt;br&gt;tujuan = +amount&lt;/span&gt;" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#E0E7FF;strokeColor=#6366F1;fontColor=#3730A3;" vertex="1" parent="p2_1">
          <mxGeometry x="565" y="390" width="225" height="65" as="geometry" />
        </mxCell>
        <mxCell id="p2_t_debt" value="&lt;b&gt;Hutang / Piutang (debt)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#854D0E;&quot;&gt;delta = +amount (kas bertambah)&lt;br&gt;Kewajiban dicatat terpisah&lt;/span&gt;" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#FEF9C3;strokeColor=#CA8A04;fontColor=#854D0E;" vertex="1" parent="p2_1">
          <mxGeometry x="815" y="390" width="215" height="65" as="geometry" />
        </mxCell>
        <mxCell id="p2_tx_step2_budget" value="&lt;b&gt;Step 2: Update Akumulasi Anggaran (Khusus Pengeluaran / Expense)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#334155;&quot;&gt;1. Resolusi Induk: budgetCatId = txnCategory.parent_id ?? category_id&lt;br&gt;2. Cari Budget: budgetRepo.findBudgetForCategory(budgetCatId)&lt;br&gt;3. Perbarui Terpakai: budgetRepo.updateSpent(budget.id, budget.spent + amount)&lt;/span&gt;" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#F1F5F9;strokeColor=#64748B;fontColor=#0F172A;align=left;spacing=10;" vertex="1" parent="p2_1">
          <mxGeometry x="70" y="485" width="960" height="75" as="geometry" />
        </mxCell>
        <mxCell id="p2_tx_step3_cache" value="&lt;b&gt;Step 3: Invalidasi Cache TanStack Query (Reaktivitas Antarmuka)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1E3A8A;&quot;&gt;await Promise.all([ invalidateQueries([wallets]), invalidateQueries([transactions]), invalidateQueries([budgets]) ])&lt;/span&gt;" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;" vertex="1" parent="p2_1">
          <mxGeometry x="70" y="585" width="960" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p2_tx_step4_sync" value="&lt;b&gt;Step 4: Asynchronous Background Cloud Sync (Non-Blocking)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#475569;&quot;&gt;GoogleSheetsRepository.sync() dieksekusi di latar belakang tanpa menghambat UI lokal&lt;/span&gt;" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#0F172A;dashed=1;" vertex="1" parent="p2_1">
          <mxGeometry x="70" y="670" width="960" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p2_tx_done" value="&lt;b&gt;Selesai: Transaksi Berhasil Disimpan&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#065F46;&quot;&gt;Saldo ter-update instan &amp;lt;16ms, toast sukses muncul di layar&lt;/span&gt;" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#D1FAE5;strokeColor=#10B981;fontColor=#065F46;" vertex="1" parent="p2_1">
          <mxGeometry x="70" y="745" width="960" height="45" as="geometry" />
        </mxCell>
        <mxCell id="p2_ec_1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#3B82F6;strokeWidth=2;" edge="1" parent="p2_1" source="p2_tx_start" target="p2_tx_hook">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2_ec_2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#3B82F6;strokeWidth=2;" edge="1" parent="p2_1" source="p2_tx_hook" target="p2_tx_step1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2_ec_inc" value="income" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#059669;strokeWidth=1.5;exitX=0.12;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="p2_1" source="p2_tx_step1" target="p2_t_inc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2_ec_exp" value="expense" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#DC2626;strokeWidth=1.5;exitX=0.38;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="p2_1" source="p2_tx_step1" target="p2_t_exp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2_ec_trans" value="transfer" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6366F1;strokeWidth=1.5;exitX=0.63;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="p2_1" source="p2_tx_step1" target="p2_t_trans">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2_ec_debt" value="debt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#CA8A04;strokeWidth=1.5;exitX=0.88;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="p2_1" source="p2_tx_step1" target="p2_t_debt">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2_ec_exp_b" value="Cek Anggaran" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#DC2626;strokeWidth=2;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.38;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="p2_1" source="p2_t_exp" target="p2_tx_step2_budget">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2_ec_b_c" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#3B82F6;strokeWidth=2;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="p2_1" source="p2_tx_step2_budget" target="p2_tx_step3_cache">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2_ec_inc_c" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#059669;strokeWidth=1.5;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.12;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="p2_1" source="p2_t_inc" target="p2_tx_step3_cache">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="180" y="570" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p2_ec_trans_c" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6366F1;strokeWidth=1.5;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.63;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="p2_1" source="p2_t_trans" target="p2_tx_step3_cache">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="677" y="570" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p2_ec_debt_c" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#CA8A04;strokeWidth=1.5;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.88;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="p2_1" source="p2_t_debt" target="p2_tx_step3_cache">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="922" y="570" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p2_ec_c_s" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#3B82F6;strokeWidth=2;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="p2_1" source="p2_tx_step3_cache" target="p2_tx_step4_sync">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2_ec_s_d" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#10B981;strokeWidth=2;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="p2_1" source="p2_tx_step4_sync" target="p2_tx_done">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2_lane_del" value="ALUR PENGHAPUSAN &amp;amp; REVERSAL (DELETE TRANSACTION)" style="swimlane;html=1;startSize=40;fillColor=#FFF1F2;strokeColor=#FECDD3;swimlaneHeadColor=#FFE4E6;fontColor=#991B1B;fontStyle=1;rounded=1;arcSize=4;" vertex="1" parent="p2_1">
          <mxGeometry x="1100" y="100" width="560" height="1000" as="geometry" />
        </mxCell>
        <mxCell id="p2_del_start" value="&lt;b&gt;Pengguna Menekan Tombol Hapus&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;Trigger via TransactionItem / Modal Konfirmasi&lt;/span&gt;" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#F43F5E;fontColor=#0F172A;" vertex="1" parent="p2_1">
          <mxGeometry x="1130" y="160" width="500" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p2_del_hook" value="&lt;b&gt;Panggil Hook useDeleteTransaction(id)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;Ambil snapshot transaksi sebelum dihapus (transactionRepo.findById)&lt;/span&gt;" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#FFE4E6;strokeColor=#E11D48;fontColor=#9F1239;" vertex="1" parent="p2_1">
          <mxGeometry x="1130" y="235" width="500" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p2_del_step1" value="&lt;b&gt;Step 1: Soft-Delete di IndexedDB&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;transactionRepo.delete(id) &amp;rarr; update({ is_deleted: true })&lt;/span&gt;" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E11D48;fontColor=#0F172A;" vertex="1" parent="p2_1">
          <mxGeometry x="1130" y="310" width="500" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p2_del_step2" value="&lt;b&gt;Step 2: Hitung Delta Reversal Saldo (getReversalDeltas)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#9F1239;&quot;&gt;&amp;bull; Hapus Pemasukan: delta = -amount (batalkan penambahan)&lt;br&gt;&amp;bull; Hapus Pengeluaran: delta = +amount (kembalikan saldo)&lt;br&gt;&amp;bull; Hapus Transfer: asal = +amount, tujuan = -amount&lt;/span&gt;" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E11D48;fontColor=#0F172A;align=left;spacing=8;" vertex="1" parent="p2_1">
          <mxGeometry x="1130" y="385" width="500" height="75" as="geometry" />
        </mxCell>
        <mxCell id="p2_del_step3" value="&lt;b&gt;Step 3: Rollback Serapan Anggaran (Expense Only)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#334155;&quot;&gt;newSpent = Math.max(0, budget.spent - txn.amount)&lt;br&gt;budgetRepo.updateSpent(budget.id, newSpent) (Proteksi nilai negatif)&lt;/span&gt;" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E11D48;fontColor=#0F172A;align=left;spacing=8;" vertex="1" parent="p2_1">
          <mxGeometry x="1130" y="485" width="500" height="65" as="geometry" />
        </mxCell>
        <mxCell id="p2_del_step4" value="&lt;b&gt;Step 4: Cache Busting &amp;amp; Background Sync&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#334155;&quot;&gt;Invalidasi cache wallets, transactions, budgets &amp;amp; push cloud&lt;/span&gt;" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E11D48;fontColor=#0F172A;" vertex="1" parent="p2_1">
          <mxGeometry x="1130" y="580" width="500" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p2_del_done" value="&lt;b&gt;Selesai: Saldo Pulih &amp;amp; Terrekonsiliasi&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#065F46;&quot;&gt;Integritas kas terjaga sempurna tanpa celah ketidakcocokan&lt;/span&gt;" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#D1FAE5;strokeColor=#10B981;fontColor=#065F46;" vertex="1" parent="p2_1">
          <mxGeometry x="1130" y="660" width="500" height="45" as="geometry" />
        </mxCell>
        <mxCell id="p2_ed_1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#E11D48;strokeWidth=2;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="p2_1" source="p2_del_start" target="p2_del_hook">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2_ed_2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#E11D48;strokeWidth=2;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="p2_1" source="p2_del_hook" target="p2_del_step1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2_ed_3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#E11D48;strokeWidth=2;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="p2_1" source="p2_del_step1" target="p2_del_step2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2_ed_4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#E11D48;strokeWidth=2;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="p2_1" source="p2_del_step2" target="p2_del_step3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2_ed_5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#E11D48;strokeWidth=2;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="p2_1" source="p2_del_step3" target="p2_del_step4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2_ed_6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#10B981;strokeWidth=2;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="p2_1" source="p2_del_step4" target="p2_del_done">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p3" name="3. Sinkronisasi Cloud Dua Arah">
    <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="p3_0" />
        <mxCell id="p3_1" parent="p3_0" />
        <mxCell id="p3_title" value="&lt;b style=&quot;font-size:18px;&quot;&gt;WLLT.Z — MESIN SINKRONISASI CLOUD DUA ARAH (GOOGLE DRIVE &amp;amp; SHEETS)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#475569;&quot;&gt;Alur detil pencarian spreadsheet, format laporan manusiawi (human-readable), dan snapshot backup JSON tersembunyi&lt;/span&gt;" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#F8FAFC;strokeColor=#CBD5E1;align=left;spacingLeft=25;fontColor=#0F172A;" vertex="1" parent="p3_1">
          <mxGeometry x="40" y="20" width="1620" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p3_s_start" value="&lt;b&gt;Trigger Sinkronisasi&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;Otomatis (useCreate / useDelete) ATAU Manual via Profil&lt;/span&gt;" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#3B82F6;fontColor=#0F172A;" vertex="1" parent="p3_1">
          <mxGeometry x="60" y="110" width="360" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p3_s_token_check" value="&lt;b&gt;Apakah accessToken Aktif?&lt;/b&gt;" style="rhombus;html=1;whiteSpace=wrap;fillColor=#FEF3C7;strokeColor=#F59E0B;fontColor=#92400E;fontStyle=1;" vertex="1" parent="p3_1">
          <mxGeometry x="480" y="110" width="280" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p3_s_token_no" value="&lt;b&gt;Token Tidak Ada / Kedaluwarsa (401)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;handleApiError(): setAccessToken(null)&lt;br&gt;Aplikasi tetap offline, data lokal aman tersimpan.&lt;/span&gt;" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#FEE2E2;strokeColor=#EF4444;fontColor=#991B1B;" vertex="1" parent="p3_1">
          <mxGeometry x="820" y="110" width="380" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p3_s_mode_check" value="&lt;b&gt;Evaluasi Mode Sinkronisasi (syncTwoWay)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;localTxCount = await db.transactions.count()&lt;/span&gt;" style="rhombus;html=1;whiteSpace=wrap;fillColor=#EFF6FF;strokeColor=#3B82F6;fontColor=#1E40AF;fontStyle=1;" vertex="1" parent="p3_1">
          <mxGeometry x="480" y="205" width="280" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p3_box_pull" value="JALUR PULL DATA (DEVICE BARU / KOSONG: localTxCount == 0)" style="swimlane;html=1;startSize=35;fillColor=#ECFDF5;strokeColor=#A7F3D0;swimlaneHeadColor=#D1FAE5;fontColor=#065F46;fontStyle=1;rounded=1;arcSize=4;" vertex="1" parent="p3_1">
          <mxGeometry x="60" y="300" width="600" height="780" as="geometry" />
        </mxCell>
        <mxCell id="p3_pl_1" value="&lt;b&gt;1. Cari Spreadsheet di Google Drive&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;Endpoint: drive/v3/files?spaces=drive (Query: &amp;quot;Catatan Keuangan Saya - Wllt.z&amp;quot;)&lt;/span&gt;" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#10B981;fontColor=#0F172A;" vertex="1" parent="p3_1">
          <mxGeometry x="90" y="360" width="540" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p3_pl_2" value="&lt;b&gt;2. Baca Tab Tersembunyi _wlltz_sync_data&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;Endpoint: sheets/v4/spreadsheets/${id}/values/_wlltz_sync_data!A1:Z5000&lt;/span&gt;" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#10B981;fontColor=#0F172A;" vertex="1" parent="p3_1">
          <mxGeometry x="90" y="445" width="540" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p3_pl_3" value="&lt;b&gt;3. Rekonstruksi Entitas Finansial&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;Ekstrak objek Categories, Wallets, Budgets, dan Transactions&lt;/span&gt;" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#10B981;fontColor=#0F172A;" vertex="1" parent="p3_1">
          <mxGeometry x="90" y="530" width="540" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p3_pl_4" value="&lt;b&gt;4. Atomic BulkPut ke Dexie IndexedDB&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;db.transaction(&amp;quot;rw&amp;quot;, [tx, cat, wal, bud]) &amp;rarr; Simpan ke basis data lokal&lt;/span&gt;" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#10B981;fontColor=#0F172A;" vertex="1" parent="p3_1">
          <mxGeometry x="90" y="615" width="540" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p3_pl_5" value="&lt;b&gt;Selesai: Database Lokal Terpulihkan 100%&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#065F46;&quot;&gt;Pengguna dapat langsung melanjutkan pencatatan pada perangkat baru&lt;/span&gt;" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#A7F3D0;strokeColor=#059669;fontColor=#065F46;" vertex="1" parent="p3_1">
          <mxGeometry x="90" y="700" width="540" height="45" as="geometry" />
        </mxCell>
        <mxCell id="p3_box_push" value="JALUR PUSH DATA (ADA DATA LOKAL: pushToDrive / syncFullFinancialReport)" style="swimlane;html=1;startSize=35;fillColor=#EFF6FF;strokeColor=#BFDBFE;swimlaneHeadColor=#DBEAFE;fontColor=#1E3A8A;fontStyle=1;rounded=1;arcSize=4;" vertex="1" parent="p3_1">
          <mxGeometry x="700" y="300" width="960" height="780" as="geometry" />
        </mxCell>
        <mxCell id="p3_ps_1" value="&lt;b&gt;1. Ambil Seluruh Data Lokal (Snapshot)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;Promise.all([transactionRepo.findAll(), categoryRepo.findAll(), walletRepo.findAll(), budgetRepo.findAll()])&lt;/span&gt;" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#3B82F6;fontColor=#0F172A;" vertex="1" parent="p3_1">
          <mxGeometry x="730" y="360" width="900" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p3_ps_2" value="&lt;b&gt;2. getOrCreateSpreadsheet() &amp;amp; ensureSheetTabs()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;Cari atau buat file spreadsheet &amp;quot;Catatan Keuangan Saya - Wllt.z&amp;quot; &amp;amp; siapkan 3 tab resmi&lt;/span&gt;" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#3B82F6;fontColor=#0F172A;" vertex="1" parent="p3_1">
          <mxGeometry x="730" y="430" width="900" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p3_ps_3" value="&lt;b&gt;3. Format Lembar 1: Catatan Keuangan (Human-Readable)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#334155;&quot;&gt;Tulis baris transaksi terurut tanggal + Formula SUM: =SUM(G5:G${endRow}) dan =G-H&lt;/span&gt;" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#3B82F6;fontColor=#0F172A;" vertex="1" parent="p3_1">
          <mxGeometry x="730" y="500" width="900" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p3_ps_4" value="&lt;b&gt;4. Format Lembar 2: Ringkasan &amp;amp; Saldo Dompet&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#334155;&quot;&gt;Daftar saldo aktual setiap dompet, Total Kekayaan Bersih, dan Rekapitulasi Anggaran&lt;/span&gt;" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#3B82F6;fontColor=#0F172A;" vertex="1" parent="p3_1">
          <mxGeometry x="730" y="575" width="900" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p3_ps_5" value="&lt;b&gt;5. Tulis Cadangan Mentah ke Tab Tersembunyi _wlltz_sync_data&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1E3A8A;&quot;&gt;Simpan dump JSON lengkap untuk menjamin pemulihan sempurna saat migrasi device&lt;/span&gt;" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;" vertex="1" parent="p3_1">
          <mxGeometry x="730" y="650" width="900" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p3_ps_6" value="&lt;b&gt;6. Terapkan Enterprise Styling (applySheetStyling)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#065F46;&quot;&gt;Header Emerald Green, Freeze 4 baris, Format Rupiah (Rp #,##0), dan Auto column width&lt;/span&gt;" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#065F46;" vertex="1" parent="p3_1">
          <mxGeometry x="730" y="720" width="900" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p3_ps_7" value="&lt;b&gt;Selesai: Spreadsheet Terupdate di Google Drive Pengguna&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#065F46;&quot;&gt;Laporan keuangan siap dilihat langsung di aplikasi Google Sheets kapan saja&lt;/span&gt;" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#A7F3D0;strokeColor=#059669;fontColor=#065F46;" vertex="1" parent="p3_1">
          <mxGeometry x="730" y="795" width="900" height="45" as="geometry" />
        </mxCell>
        <mxCell id="p3_es_1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#3B82F6;strokeWidth=2;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p3_1" source="p3_s_start" target="p3_s_token_check">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_es_2" value="Tidak Ada / 401" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#EF4444;strokeWidth=2;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p3_1" source="p3_s_token_check" target="p3_s_token_no">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_es_3" value="Token Valid" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#10B981;strokeWidth=2;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="p3_1" source="p3_s_token_check" target="p3_s_mode_check">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_es_pull" value="localTxCount == 0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#059669;strokeWidth=2;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="p3_1" source="p3_s_mode_check" target="p3_pl_1">
          <mxGeometry relative="1" as="geometry">
