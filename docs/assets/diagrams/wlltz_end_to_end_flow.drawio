  <diagram id="p4" name="4. Bootstrapping &amp; Multi-User">
    <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="p4_0" />
        <mxCell id="p4_1" parent="p4_0" />
        <mxCell id="p4_title" value="&lt;b style=&quot;font-size:18px;&quot;&gt;WLLT.Z — INISIALISASI PWA, AUTENTIKASI &amp;amp; ISOLASI MULTI-USER&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#475569;&quot;&gt;Alur siklus booting aplikasi, eliminasi race condition TanStack Query, dan isolasi basis data IndexedDB per pengguna&lt;/span&gt;" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#F8FAFC;strokeColor=#CBD5E1;align=left;spacingLeft=25;fontColor=#0F172A;" vertex="1" parent="p4_1">
          <mxGeometry x="40" y="20" width="1620" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p4_lane_boot" value="1. SIKLUS BOOTING &amp;amp; INITIALIZATION GATE (AppInitializer)" style="swimlane;html=1;startSize=40;fillColor=#F8FAFC;strokeColor=#93C5FD;swimlaneHeadColor=#DBEAFE;fontColor=#1E3A8A;fontStyle=1;rounded=1;arcSize=4;" vertex="1" parent="p4_1">
          <mxGeometry x="40" y="100" width="760" height="980" as="geometry" />
        </mxCell>
        <mxCell id="p4_bt_1" value="&lt;b&gt;Aplikasi Dibuka (PWA / Browser)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;main.tsx memuat QueryClientProvider &amp;amp; me-mount &amp;lt;AppInitializer&amp;gt;&lt;/span&gt;" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#3B82F6;fontColor=#0F172A;" vertex="1" parent="p4_1">
          <mxGeometry x="70" y="160" width="700" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p4_bt_2" value="&lt;b&gt;Render SplashScreen (Gerbang Inisialisasi)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1E3A8A;&quot;&gt;Status isReady = false &amp;bull; Children belum di-mount untuk mencegah race condition&lt;/span&gt;" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E40AF;" vertex="1" parent="p4_1">
          <mxGeometry x="70" y="240" width="700" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p4_bt_3" value="&lt;b&gt;Eksekusi bootstrapLocalDB() secara Sekuensial&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#334155;&quot;&gt;&amp;bull; seedDefaultCategories() &amp;bull; seedDefaultWallets() &amp;bull; seedDefaultSettings()&lt;/span&gt;" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#10B981;fontColor=#0F172A;" vertex="1" parent="p4_1">
          <mxGeometry x="70" y="330" width="700" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p4_bt_4" value="&lt;b&gt;Bust Query Cache: queryClient.invalidateQueries()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1E3A8A;&quot;&gt;Membersihkan query kosong yang sempat ter-cache dengan staleTime: Infinity&lt;/span&gt;" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;" vertex="1" parent="p4_1">
          <mxGeometry x="70" y="430" width="700" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p4_bt_5" value="&lt;b&gt;Flip isReady = true &amp;rarr; Dismiss Splash Screen&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#065F46;&quot;&gt;Pohon komponen &amp;lt;App /&amp;gt; di-render dengan kepastian data lokal lengkap&lt;/span&gt;" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#D1FAE5;strokeColor=#10B981;fontColor=#065F46;" vertex="1" parent="p4_1">
          <mxGeometry x="70" y="520" width="700" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p4_eb_1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#3B82F6;strokeWidth=2;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="p4_1" source="p4_bt_1" target="p4_bt_2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4_eb_2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#3B82F6;strokeWidth=2;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="p4_1" source="p4_bt_2" target="p4_bt_3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4_eb_3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#10B981;strokeWidth=2;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="p4_1" source="p4_bt_3" target="p4_bt_4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4_eb_4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#3B82F6;strokeWidth=2;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="p4_1" source="p4_bt_4" target="p4_bt_5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4_lane_auth" value="2. ALUR AUTENTIKASI &amp;amp; ISOLASI BASIS DATA (setDatabaseUser)" style="swimlane;html=1;startSize=40;fillColor=#F8FAFC;strokeColor=#A7F3D0;swimlaneHeadColor=#D1FAE5;fontColor=#065F46;fontStyle=1;rounded=1;arcSize=4;" vertex="1" parent="p4_1">
          <mxGeometry x="830" y="100" width="830" height="980" as="geometry" />
        </mxCell>
        <mxCell id="p4_au_check" value="&lt;b&gt;Cek Status Sesi: currentUser di authStore&lt;/b&gt;" style="rhombus;html=1;whiteSpace=wrap;fillColor=#FEF3C7;strokeColor=#F59E0B;fontColor=#92400E;fontStyle=1;" vertex="1" parent="p4_1">
          <mxGeometry x="860" y="160" width="770" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p4_au_login_view" value="&lt;b&gt;Pengguna Belum Login &amp;rarr; Tampilkan AuthView&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#334155;&quot;&gt;Pilihan: Google One-Tap OAuth (GIS Client) ATAU Akun Lokal (Email / Password)&lt;/span&gt;" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#0F172A;" vertex="1" parent="p4_1">
          <mxGeometry x="860" y="245" width="770" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p4_au_set_db" value="&lt;b&gt;Login Berhasil &amp;rarr; Eksekusi setDatabaseUser(userId)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#065F46;&quot;&gt;Buat instance Dexie baru wllt_db_${userId} &amp;bull; Data antar pengguna terisolasi 100% di browser&lt;/span&gt;" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#065F46;" vertex="1" parent="p4_1">
