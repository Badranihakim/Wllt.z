          </mxGeometry>
        </mxCell>
        <mxCell id="p3_epl_1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#10B981;strokeWidth=1.5;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="p3_1" source="p3_pl_1" target="p3_pl_2">
